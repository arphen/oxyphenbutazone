    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.55.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.31.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.3.3",
    "qrcode": "^1.5.4",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
